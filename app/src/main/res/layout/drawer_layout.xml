<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<androidx.drawerlayout.widget.DrawerLayout
		android:id="@+id/drawerLayout"
		android:layout_width="fill_parent"
		android:layout_height="fill_parent">
		android:background="?colorPrimary">

		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<androidx.coordinatorlayout.widget.CoordinatorLayout
				android:id="@+id/coordinator"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				tools:context="SocksHttpmain.MainActivity">

				<include
					layout="@layout/activity_home"/>

				<include
					layout="@layout/buttom_sheet"/>

			</androidx.coordinatorlayout.widget.CoordinatorLayout>

		</LinearLayout>

	<com.google.android.material.navigation.NavigationView
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:background="@drawable/nav_header_bg"
		android:fitsSystemWindows="true"
		android:clickable="true"
        app:itemTextAppearance="@style/NavigationView"   
        app:itemIconSize="23dp"    
		app:itemIconTint="#25aae2"
		app:itemTextColor="@color/nav_textcolor"
		app:menu="@menu/navigation_menu"
		android:layout_gravity="start"
		app:headerLayout="@layout/nav_header"
		android:id="@+id/drawerNavigationView" >
    
    <LinearLayout 
        android:visibility="visible"       
        android:gravity="bottom|center"
        android:orientation="vertical"
        android:layout_width="fill_parent" 
        android:layout_height="fill_parent">
        
        <TextView 
            android:textColor="#454c58" 
            android:id="@+id/hidden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip" 
            android:text="Powered by KKZ PLUS VPN PRO" />
        
          </LinearLayout>
    
       </com.google.android.material.navigation.NavigationView>

    </androidx.drawerlayout.widget.DrawerLayout>

</LinearLayout>


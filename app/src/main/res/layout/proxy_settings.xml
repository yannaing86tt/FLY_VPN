<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:sweet="http://schemas.android.com/apk/res-auto"
	xmlns:aapt="http://schemas.android.com/aapt"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context="me.dawson.proxyserver.ui.ProxySettings">

	<include
		layout="@layout/toolbar_main"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"/>

		<androidx.cardview.widget.CardView
			android:layout_width="match_parent"
			android:layout_height="90dp"
            sweet:cardBackgroundColor="#452CAC"
			android:layout_marginLeft="8dp"
			android:layout_marginTop="10dp"
			android:layout_marginRight="8dp"
			sweet:cardCornerRadius="2dp"
			sweet:cardElevation="2dp"
			sweet:contentPadding="10dp">

		  <LinearLayout
			 android:layout_width="match_parent"
		 	 android:layout_height="70dp"
		 	 android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="25dp"
				android:layout_margin="5dp"
				android:orientation="horizontal">

            <TextView
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Hostname:" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal" />
                
            <LinearLayout
		    	android:gravity="left|center_vertical|center_horizontal|center"
				android:orientation="horizontal"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="10dp">

            <TextView          
                android:focusable="true"
                android:longClickable="true"
                android:textIsSelectable="true"
                android:id="@+id/ip_layout"
                android:textStyle="bold"
                android:textColor="#FF1EDACA"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp" />

              </LinearLayout>
                
            </LinearLayout>

				<LinearLayout
					android:orientation="horizontal"
					android:layout_width="match_parent"
					android:layout_height="25dp"
					android:layout_margin="5dp">

					<TextView
						android:textColor="#FFFFFF"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:text="Proxy Port:"/>

					<LinearLayout
						android:orientation="horizontal"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:layout_weight="1"/>

					<TextView
						android:id="@+id/textport"
						android:textIsSelectable="true"
						android:focusable="true"
						android:longClickable="true"
						android:textColor="#FF1EDACA"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:layout_marginLeft="10dp"
						android:text="8080"/>

				</LinearLayout>

			</LinearLayout>

		</androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:background="@color/colorPrimaryBackground"
        android:orientation="vertical"
        android:gravity="center">

            <Switch
                android:id="@+id/cb_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:textOff="HOSTPOT PROXY OFF"
                android:textOn="HOSTPOT PROXY ON"
                android:textColor="#FFF0A808"
                android:text="Hostpot Proxy"
		    	android:textStyle="bold"
		    	android:textSize="18sp"
		    	android:padding="5dp" >
                        
        </Switch>
 
          <Button
			android:id="@+id/zonawifi"
			android:layout_width="220dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			android:layout_marginTop="2dp"
			android:gravity="center"
			android:layout_gravity="center"
			android:layout_marginEnd="10dp"
			android:layout_marginBottom="2dp"
			android:text="Activate Hotspot"
			android:clickable="true"
			android:textColor="#FFFFFFFF"
			android:background="@drawable/butys"/>
     
         <TextView
			android:id="@+id/tv_info"
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:textSize="12pt"/>
	
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="200dp"
			android:layout_margin="10dp"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center"
				android:layout_gravity="center"
				android:orientation="horizontal">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="35dp"
					android:textColor="#452CAC"
					android:text="Tutorial Hostpot Proxy"
					android:textStyle="bold|normal"
					android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
					android:textSize="25sp"/>

			</LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="10.0dip"
                android:layout_marginBottom="5.0dip"
                sweet:cardElevation="5.0dip">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10.0dip">

                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip" />
                    
                    <TextView
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp" 
                        android:text="1. Connect another device to the WiFi network using the SSID / Password."/>

                    <TextView
                        android:textColor="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="2. Configure the proxy on the connected device."/>

                    <TextView
                        android:textColor="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Guide:"/>

                    <TextView
                        android:textColor="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="(Search online how to set up the proxy on your device or refer to this guide)"/>

                    <TextView
                        android:textColor="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="No need to install this app and run Hotshare on the other device"/>
					
                  </LinearLayout>
                
             </androidx.cardview.widget.CardView>

         </LinearLayout>
    
     </LinearLayout>	

</LinearLayout>
